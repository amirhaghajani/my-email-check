# Copy this file to .env and edit. Do NOT put credentials here.
#
# With MAIL_BACKEND=ews, EXCHANGE_USERNAME and EXCHANGE_PASSWORD are requested
# interactively at startup (hidden password input). They are never read from this
# file or environment variables.
# With MAIL_BACKEND=outlook, no credentials are needed (uses the local Outlook profile).

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible). The model MUST support function/tool calling.
#   Ollama:      http://localhost:11434/v1   key: not-needed
#   OpenRouter:  https://openrouter.ai/api/v1 key: sk-or-...
#   OpenAI:      https://api.openai.com/v1    key: sk-...
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5
LLM_CONTEXT_WINDOW=32768

# ---------------------------------------------------------------------------
# Mail backend: ews (service account) or outlook (local Outlook profile / MAPI)
# ---------------------------------------------------------------------------
MAIL_BACKEND=ews

# --- EWS backend (MAIL_BACKEND=ews) ---
# Use one of: a server host, a full EWS URL, or autodiscover.
EXCHANGE_SERVER=mail.company.local
# EXCHANGE_EWS_URL=https://mail.company.local/EWS/Exchange.asmx
# EXCHANGE_AUTODISCOVER=true
# NTLM | BASIC | GSSAPI
EXCHANGE_AUTH_TYPE=NTLM
EXCHANGE_VERIFY_SSL=true
EXCHANGE_ACCESS_TYPE=IMPERSONATION
MAILBOX_EMAIL=operator@company.local

# --- Outlook backend (MAIL_BACKEND=outlook) ---
# No credentials needed; uses the already-configured Outlook profile.
# MAILBOX_EMAIL is optional for this backend.

# ---------------------------------------------------------------------------
# PostgreSQL (crawl + embeddings)
# Example: postgresql://user:pass@localhost:5432/mailagent
# EMBEDDING_MODEL must exist on the LLM provider (e.g. `ollama pull nomic-embed-text`)
# ---------------------------------------------------------------------------
DATABASE_URL=
EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
OUTPUT_DIR=reports
REPORT_SHOW_SECRETS=false
SEND_AUTO_APPROVE=false